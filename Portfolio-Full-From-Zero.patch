index 0000000..91d7b2e
--- /dev/null
+++ b/src/index.css
@@ -0,0 +1,680 @@
+/* ———————————————————————————————
+  AMIT PAL — CURATED PORTFOLIO
+  Trailer, Not Movie — Visual Density > Text Density
+  Multi-breakpoint system: 320 / 375 / 480 / 640 / 768 / 900 / 1024 / 1100 / 1280 / 1440 / 1600
+  Laptop + Mobile both designed, not just shrunk
+  ——————————————————————————————— */
+
+:root {
+  --black: #050507;
+  --black-2: #0A0A0F;
+  --white: #F5F3EF;
+  --cream: #FFF8EC;
+  --cream-2: #FFF1D6;
+  --electric-blue: #3A5BFF;
+  --cyan: #6EFFE5;
+  --signal-green: #00FF9D;
+  --teal-dark: #0A0F0D;
+  --purple-deep: #0F0A1A;
+  --purple-electric: #8A5CFF;
+  --pink: #FF5CA1;
+  --orange: #FF4D00;
+  --orange-light: #FFC4A8;
+  --gold: #FFD60A;
+  --gray-900: #111111;
+  --gray-700: #2A2A2A;
+  --gray-500: #8A8A8A;
+  --gray-300: #CFCFCF;
+  --border: rgba(255,255,255,0.08);
+  --border-light: rgba(0,0,0,0.08);
+
+  --font-display: 'Syne', sans-serif;
+  --font-sans: 'Space Grotesk', sans-serif;
+  --font-serif: 'Instrument Serif', serif;
+  --font-serif-2: 'Newsreader', serif;
+  --font-mono: 'IBM Plex Mono', monospace;
+
+  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
+  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
+
+  --content-max: 1400px;
+  --pad-desktop: 48px;
+  --pad-laptop: 32px;
+  --pad-tablet: 24px;
+  --pad-mobile: 20px;
+  --pad-small: 16px;
+}
+
+[data-theme="light"] {
+  --black: #FFF8EC;
+  --black-2: #FFF1D6;
+  --white: #111111;
+  --cream: #050507;
+  --cream-2: #0A0A0F;
+  --gray-900: #FFF8EC;
+  --gray-700: #E5DDC8;
+  --gray-500: #6B6B6B;
+  --gray-300: #2A2A2A;
+  --border: rgba(0,0,0,0.08);
+  --border-light: rgba(0,0,0,0.08);
+}
+
+[data-theme="light"] body {
+  background: #FFF8EC;
+  color: #0A0A0F;
+}
+
+[data-theme="light"] .hero {
+  background: #FFF8EC;
+}
+
+[data-theme="light"] .nav {
+  color: #0A0A0F;
+  mix-blend-mode: normal;
+}
+
+[data-theme="light"] .manifesto {
+  background: #FFF8EC;
+}
+
+[data-theme="light"] .section-header {
+  background: #FFF8EC;
+}
+
+[data-theme="light"] .writing-responsive {
+  background: rgba(0,0,0,0.04) !important;
+}
+
+[data-theme="light"] .writing-featured {
+  background: white !important;
+}
+
+[data-theme="light"] .noise {
+  opacity: 0.02;
+}
+
+* { margin: 0; padding: 0; box-sizing: border-box; }
+html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
+body {
+  background: var(--black);
+  color: var(--white);
+  font-family: var(--font-sans);
+  overflow-x: hidden;
+  cursor: none;
+}
+@media (max-width: 1024px) { body { cursor: auto; } }
+
+.skip-link {
+  position: absolute;
+  top: -100%; left: 16px;
+  background: var(--white); color: var(--black);
+  padding: 12px 20px;
+  font-family: var(--font-mono); font-size: 11px;
+  letter-spacing: 0.15em; text-transform: uppercase;
+  z-index: 100000; transition: top 0.3s;
+}
+.skip-link:focus { top: 16px; }
+
+a:focus-visible, button:focus-visible {
+  outline: 2px solid var(--electric-blue);
+  outline-offset: 3px;
+}
+a { color: inherit; text-decoration: none; }
+button { background: none; border: none; color: inherit; font: inherit; cursor: pointer; }
+img { display: block; max-width: 100%; }
+::selection { background: var(--electric-blue); color: white; }
+
+::-webkit-scrollbar { width: 6px; height: 6px; }
+::-webkit-scrollbar-track { background: var(--black); }
+::-webkit-scrollbar-thumb { background: var(--gray-700); border-radius: 3px; }
+
+/* ——— Noise ——— */
+.noise {
+  position: fixed; inset: -50%; width: 200%; height: 200%;
+  pointer-events: none; z-index: 9999; opacity: 0.035;
+  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
+  animation: noise-move 0.2s infinite;
+}
+@keyframes noise-move {
+  0% { transform: translate(0,0); }
+  20% { transform: translate(1%,1%); }
+  40% { transform: translate(2%,-1%); }
+  60% { transform: translate(1%,-2%); }
+  80% { transform: translate(2%,1%); }
+  100% { transform: translate(1%,1%); }
+}
+
+/* ——— Cursor ——— */
+.cursor {
+  position: fixed; top: 0; left: 0; width: 24px; height: 24px;
+  border: 1px solid rgba(255,255,255,0.5); border-radius: 50%;
+  pointer-events: none; z-index: 10000; mix-blend-mode: difference;
+  transition: width 0.3s var(--ease-out-expo), height 0.3s var(--ease-out-expo), background 0.3s, border-color 0.3s, color 0.3s;
+  display: flex; align-items: center; justify-content: center;
+}
+.cursor-dot {
+  position: fixed; top: 0; left: 0; width: 4px; height: 4px;
+  background: white; border-radius: 50%; pointer-events: none; z-index: 10001; mix-blend-mode: difference;
+  transition: background 0.3s;
+}
+.cursor.hover { width: 72px; height: 72px; background: rgba(255,255,255,0.08); }
+.cursor.hover .cursor-label { opacity: 1; }
+.cursor-label {
+  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
+  text-transform: uppercase; opacity: 0; transition: opacity 0.2s; color: white;
+}
+@media (max-width: 1024px) { .cursor, .cursor-dot { display: none; } }
+
+/* ——— Scroll Progress ——— */
+.scroll-progress {
+  position: fixed; top: 0; left: 0; height: 2px;
+  background: var(--electric-blue); z-index: 101;
+  transform-origin: left; transition: background-color 0.5s ease;
+}
+
+/* ——— Navigation ——— */
+.nav {
+  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
+  display: flex; justify-content: space-between; align-items: center;
+  padding: 20px 32px; mix-blend-mode: difference; color: white;
+}
+.nav-logo { font-family: var(--font-display); font-weight: 800; font-size: 16px; letter-spacing: -0.02em; line-height: 0.9; }
+.nav-logo span { display: block; }
+.nav-links { display: flex; gap: 28px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; }
+.nav-links a { position: relative; padding: 4px 0; }
+.nav-links a::after {
+  content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 1px;
+  background: currentColor; transform: scaleX(0); transform-origin: right;
+  transition: transform 0.5s var(--ease-out-expo);
+}
+.nav-links a:hover::after, .nav-links a.active::after { transform: scaleX(1); transform-origin: left; }
+.nav-time { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; opacity: 0.6; }
+.mobile-nav-toggle {
+  display: none; width: 44px; height: 44px; align-items: center; justify-content: center;
+  border: 1px solid rgba(255,255,255,0.15); background: rgba(0,0,0,0.5); backdrop-filter: blur(12px);
+  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
+}
+.mobile-nav {
+  position: fixed; inset: 0; background: var(--black); z-index: 99;
+  display: flex; flex-direction: column; padding: 100px 24px 32px;
+  transform: translateX(100%); transition: transform 0.6s var(--ease-out-expo);
+}
+.mobile-nav.open { transform: translateX(0); }
+.mobile-nav-links { display: flex; flex-direction: column; gap: 0; flex: 1; }
+.mobile-nav-links a {
+  font-family: var(--font-display); font-size: clamp(32px, 8vw, 56px); font-weight: 800;
+  line-height: 0.9; letter-spacing: -0.03em; text-transform: uppercase;
+  padding: 20px 0; border-bottom: 1px solid var(--border);
+  display: flex; justify-content: space-between; align-items: center;
+}
+.mobile-nav-links a span:last-child { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.15em; opacity: 0.4; }
+.mobile-nav-footer { margin-top: auto; display: flex; flex-direction: column; gap: 16px; font-family: var(--font-mono); font-size: 11px; color: var(--gray-500); }
+.nav-links a.active { color: var(--cyan); }
+.nav-links a.active::after { background: var(--cyan); }
+
+/* ——— Hero ——— */
+.hero {
+  position: relative; min-height: 100vh; background: var(--black);
+  display: flex; flex-direction: column; justify-content: flex-end; padding: 0; overflow: hidden;
+}
+.hero-grid {
+  position: absolute; inset: 0;
+  background-image:
+    linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
+    linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
+  background-size: 80px 80px;
+  mask-image: radial-gradient(ellipse at center, black 40%, transparent 80%);
+}
+.hero-glow {
+  position: absolute; width: 800px; height: 800px; border-radius: 50%;
+  background: radial-gradient(circle, rgba(58,91,255,0.15) 0%, rgba(110,255,229,0.08) 30%, transparent 70%);
+  top: -200px; right: -100px; filter: blur(40px); pointer-events: none;
+}
+.hero-content {
+  position: relative; z-index: 2; display: grid; grid-template-columns: 1.2fr 0.8fr;
+  min-height: 100vh; align-items: end; padding: 120px 48px 48px; gap: 48px;
+}
+.hero-left { display: flex; flex-direction: column; gap: 32px; }
+.hero-title {
+  font-family: var(--font-display); font-weight: 800;
+  font-size: clamp(52px, 8vw, 112px); line-height: 0.88; letter-spacing: -0.05em; text-transform: uppercase;
+}
+.hero-title-line { display: block; overflow: hidden; position: relative; }
+.hero-title-line span { display: block; transform: translateY(100%); }
+.hero-title-line.outline { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.3); }
+.hero-tagline {
+  font-family: var(--font-mono); font-size: clamp(12px, 1.1vw, 14px); line-height: 1.6;
+  letter-spacing: 0.02em; color: var(--gray-300); max-width: 520px;
+  display: flex; flex-direction: column; gap: 8px;
+}
+.hero-tagline b { color: var(--cyan); font-weight: 500; }
+.hero-tagline p { overflow: hidden; }
+.hero-tagline p span { display: block; transform: translateY(100%); }
+.hero-right { position: relative; height: 100%; min-height: 60vh; display: flex; align-items: center; justify-content: center; }
+.hero-visual { position: relative; width: 100%; aspect-ratio: 1; max-width: 520px; }
+.hero-marquee {
+  position: absolute; bottom: 0; left: 0; right: 0;
+  border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
+  padding: 14px 0; overflow: hidden; background: rgba(5,5,7,0.8); backdrop-filter: blur(20px); z-index: 3;
+}
+.marquee-track { display: flex; gap: 48px; animation: marquee 30s linear infinite; white-space: nowrap; will-change: transform; }
+.marquee-item {
+  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
+  color: var(--gray-500); display: flex; align-items: center; gap: 48px;
+}
+.marquee-item::after { content: '●'; color: var(--electric-blue); font-size: 6px; }
+@keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
+
+/* ——— Section Header ——— */
+.section-header {
+  position: relative; padding: 80px 48px 40px;
+  display: flex; justify-content: space-between; align-items: flex-end;
+  border-top: 1px solid var(--border); background: var(--black);
+}
+.section-num { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gray-500); }
+.section-title {
